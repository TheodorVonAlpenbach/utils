;;; mb-evil-map.el --- Personal Evil key bindings -*- lexical-binding: t; -*-

;;; Code:

(require 'vc)

(declare-function evil-key-chord-define "mb-evil")
(declare-function mb-evil-buffer "mb-evil")
(declare-function mb-evil-inner-defun "mb-evil")
(declare-function mb-evil-inner-variable-name "mb-evil")
(declare-function key-chord-define "key-chord")
(declare-function key-chord-mode "key-chord")
(declare-function backward-date nil)
(declare-function browse-kill-ring nil)
(declare-function buffer-file-name-to-clipboard nil)
(declare-function buffer-name-to-clipboard nil)
(declare-function cl-ify-defun nil)
(declare-function cl-ify-form nil)
(declare-function comment-region* nil)
(declare-function eval-current-sexp nil)
(declare-function eval-defun-test nil)
(declare-function eval-form nil)
(declare-function ffap-next nil)
(declare-function ffap-no-prompt nil)
(declare-function ffap-no-prompt-read-only nil)
(declare-function ffap-previous nil)
(declare-function find-tag-no-prompt nil)
(declare-function find-tag-no-prompt-read-only nil)
(declare-function forward-date nil)
(declare-function inc-thing-at-point nil)
(declare-function insert-date nil)
(declare-function insert-date-and-time nil)
(declare-function insert-n nil)
(declare-function insert-provide nil)
(declare-function insert-symbol-bullet nil)
(declare-function insert-symbol-deg nil)
(declare-function insert-symbol-sup2 nil)
(declare-function insert-symbol-sup3 nil)
(declare-function insert-time nil)
(declare-function ls-insert-arrival-time nil)
(declare-function ls-insert-depature-time nil)
(declare-function mb-compile-buffer nil)
(declare-function mb-eval-buffer nil)
(declare-function mb-eval-defun nil)
(declare-function mb-eval-last-sexp nil)
(declare-function mb-eval-region nil)
(declare-function mb-eval-region-from-point nil)
(declare-function mb-eval-region-to-point nil)
(declare-function mb-grep nil)
(declare-function mb-grep-interactive nil)
(declare-function mb-surround nil)
(declare-function mb-texinfo-insert-@var nil)
(declare-function mb-undo-surround nil)
(declare-function reverse-sexps nil)
(declare-function rotate-sexps nil)
(declare-function rotate-windows nil)
(declare-function smart-swap nil)
(declare-function sp-backward-up-sexp "smartparens")
(declare-function sp-down-sexp "smartparens")
(declare-function sp-up-sexp "smartparens")
(declare-function swap-windows nil)
(declare-function transpose-split-orientation nil)
(declare-function uncomment-region* nil)
(declare-function unbury-buffer nil)

(defvar evil-exchange-key)
(defvar evil-exchange-cancel-key)
(defvar evil-normal-state-map)
(defvar evil-insert-state-map)
(defvar evil-outer-text-objects-map)
(defvar evil-inner-text-objects-map)

(defvaralias '*eval-map* 'mb-evil-eval-map)

(defvaralias '*clipboard-map* 'mb-evil-clipboard-map)

(defvar mb-evil-eval-map (make-sparse-keymap)
  "Prefix map for evaluation commands.")

(defvar mb-evil-clipboard-map (make-sparse-keymap)
  "Prefix map for clipboard commands.")

(defun mb-evil-map-setup ()
  "Install personal Evil and key-chord bindings."
  (interactive)
  (unless (and (featurep 'mb-evil) (featurep 'key-chord))
    (user-error "Load mb-evil and key-chord before installing bindings"))

;; check if this must be done before install
(setf evil-exchange-key "go")
(setf evil-exchange-cancel-key "gO")

(define-key global-map "\M-x" 'execute-extended-command)
(define-key evil-normal-state-map "\M-x" 'execute-extended-command)
(define-key evil-normal-state-map " " 'scroll-up-command)
(define-key evil-normal-state-map [return] 'scroll-down-command)
(define-key evil-normal-state-map "ga" 'what-cursor-position)
(define-key evil-normal-state-map "gr" 'evil-rot47)
(define-key evil-normal-state-map "gR" 'evil-rot13)
(define-key evil-normal-state-map "gl" 'evil-split-5-points-string)

;;(evil-define-key '(motion) global-map [tab] #'forward-button)
;;(evil-define-key '(normal) global-map [tab] #'self-insert-command)
;;(define-key global-map [tab] #'self-insert-command)

(key-chord-mode 1)
(key-chord-define evil-insert-state-map "dg" 'evil-move-past-close)
(key-chord-define evil-insert-state-map "df" 'evil-normal-state)
(key-chord-define evil-insert-state-map "a;" 'yank)
(key-chord-define evil-normal-state-map "j;" 'save-buffer)
(key-chord-define evil-normal-state-map "J:" 'save-some-buffers)
(evil-key-chord-define '(normal visual motion) global-map "uu" 'undo-tree-redo)
(evil-key-chord-define
 '(normal visual motion) global-map "vn" 'ido-switch-buffer)

(define-key vc-prefix-map "j" 'log-edit-done)
(key-chord-define evil-normal-state-map "vk" vc-prefix-map)

(define-key evil-normal-state-map  [?g ? ] 'just-one-space)
(define-key evil-normal-state-map  [?g return] 'delete-blank-lines)
(define-key evil-normal-state-map "gp" 'next-error)
(define-key evil-normal-state-map "gP" 'previous-error)
(define-key evil-normal-state-map "gI" 'mb-show-process-buffer)
(define-key evil-normal-state-map "gs" 'isearch-forward)
(define-key evil-normal-state-map "gS" 'isearch-backward)

(let ((evil-sp-map (make-sparse-keymap)))
  (evil-key-chord-define '(normal motion) global-map "gb" evil-sp-map)
  (define-key evil-sp-map "j" #'sp-down-sexp)
  (define-key evil-sp-map "k" #'sp-up-sexp)
  (define-key evil-sp-map "K" #'sp-backward-up-sexp))

(evil-key-chord-define
 '(normal visual motion) global-map "GG" 'evil-goto-line-keep-column)

(let ((window-map (make-sparse-keymap)))
  (evil-key-chord-define '(normal motion) global-map "vw" window-map)
  (define-key window-map "h" #'split-window-right)
  (define-key window-map "v" #'split-window-below)
  (define-key window-map "t" #'transpose-split-orientation)
  (define-key window-map "s" #'swap-windows)
  (define-key window-map "r" #'rotate-windows)
  (define-key window-map "d" #'delete-window)
  (define-key window-map "D" #'delete-other-windows)
  (define-key window-map "o" #'other-window)
  (define-key window-map "O" #'(lambda () (interactive) (other-window -1))))

(let ((date-map (make-sparse-keymap)))
  (evil-key-chord-define '(normal motion) global-map "dp" date-map)
  (define-key date-map "f" #'forward-date)
  (define-key date-map "F" #'backward-date)
  (define-key date-map "p" #'(lambda (n) (interactive "p")
			       (inc-thing-at-point n '(:minute 5))))
  (define-key date-map "P" #'(lambda (n) (interactive "p")
			       (inc-thing-at-point n '(:minute -5))))
  (define-key date-map "t" #'(lambda (n) (interactive "p")
			       (inc-thing-at-point n '(:minute 10))))
  (define-key date-map "T" #'(lambda (n) (interactive "p")
			       (inc-thing-at-point n '(:minute -10))))
  (define-key date-map "q" #'(lambda (n) (interactive "p")
			       (inc-thing-at-point n '(:minute 15))))
  (define-key date-map "Q" #'(lambda (n) (interactive "p")
			       (inc-thing-at-point n '(:minute -15))))
  (define-key date-map "d" #'(lambda (n) (interactive "p")
			       (inc-thing-at-point n '(:minute 30))))
  (define-key date-map "D" #'(lambda (n) (interactive "p")
			       (inc-thing-at-point n '(:minute -30))))
  (define-key date-map "h" #'(lambda (n) (interactive "p")
			       (inc-thing-at-point n '(:minute 60))))
  (define-key date-map "H" #'(lambda (n) (interactive "p")
			       (inc-thing-at-point n '(:minute -60)))))

(let ((swap-map (make-sparse-keymap)))
  (evil-key-chord-define '(normal motion) global-map "vo" swap-map)
  (define-key swap-map "a" #'ffap-no-prompt)
  (define-key swap-map "A" #'ffap-no-prompt-read-only)
  (define-key swap-map "b" #'bury-buffer)
  (define-key swap-map "B" #'unbury-buffer)
  (define-key swap-map "d" #'(lambda () (interactive)
				     (kill-buffer (current-buffer))))
  (define-key swap-map "f" #'find-file)
  (define-key swap-map "g" #'mb-grep)
  (define-key swap-map "G" #'mb-grep-interactive)
  (define-key swap-map "F" #'find-file-read-only)
  (define-key swap-map "k" #'browse-kill-ring)
  (define-key swap-map "n" #'ffap-next)
  (define-key swap-map "N" #'ffap-previous)
  (define-key swap-map "r" #'revert-buffer)
  (define-key swap-map "s" #'smart-swap)
  (define-key swap-map "T" #'find-tag-no-prompt)
  (define-key swap-map "t" #'find-tag-no-prompt-read-only)
  (define-key swap-map "v" #'(lambda () (interactive)
				     (switch-to-buffer (other-buffer)))))

(let ((div-map (make-sparse-keymap)))
  ;; memo: by default we are incrementing decimeters! (dm)
  (evil-key-chord-define '(normal motion) global-map "dm" div-map)
  (define-key div-map "l" (lambda (n) (interactive "p")
			    (inc-thing-at-point n 1))) ;e.g. minutes
  (define-key div-map "h" (lambda (n) (interactive "p")
			    (inc-thing-at-point (- n) 1)))
  (define-key div-map "j" (lambda (n) (interactive "p")
			    (inc-thing-at-point n 2)))
  (define-key div-map "k" (lambda (n) (interactive "p")
			    (inc-thing-at-point (- n) 2)))
  (define-key div-map "\M-j" (lambda (n) (interactive "p")
			       (inc-thing-at-point n 3)))
  (define-key div-map "\M-k" (lambda (n) (interactive "p")
			       (inc-thing-at-point (- n) 3))))

(let ((insert-map (make-sparse-keymap)))
  (key-chord-define evil-normal-state-map "vi" insert-map)
  (define-key insert-map "a" #'ls-insert-arrival-time)
  (define-key insert-map "A" #'ls-insert-depature-time)
  (define-key insert-map "b" #'insert-symbol-bullet)
  (define-key insert-map "c" #'comment-region*)
  (define-key insert-map "d" #'insert-date)
  (define-key insert-map "D" #'(lambda () (interactive) (insert-date-and-time 3)))
  (define-key insert-map "f" #'cl-ify-form)
  (define-key insert-map "F" #'cl-ify-defun)
  (define-key insert-map "q" #'fill-paragraph)
  (define-key insert-map "p" #'insert-provide)
  (define-key insert-map "r" #'reverse-sexps)
  (define-key insert-map "R" #'rotate-sexps)
  (define-key insert-map "t" #'insert-time)
  (define-key insert-map "T" #'(lambda () (interactive) (insert-time 3)))
  (define-key insert-map "u" #'uncomment-region*)
  (define-key insert-map "*" #'(lambda (n) (interactive "P")
				 (mb-surround "*" (or n 1))))
  (define-key insert-map "+" #'(lambda (n) (interactive "P")
				 (mb-surround "+" (or n 1))))
  (define-key insert-map "'" #'(lambda (n) (interactive "P")
				 (mb-surround "'" (or n 1))))
  (define-key insert-map "\"" #'(lambda (n) (interactive "P")
				  (mb-surround "\"" (or n 1))))
  (define-key insert-map "`" #'(lambda (n) (interactive "P")
				 (mb-surround "`" (or n 1))))
  (define-key insert-map "g" #'(lambda (n) (interactive "P")
				 (mb-surround "«" (or n 1))))
  (define-key insert-map "[" #'(lambda (n) (interactive "P")
				 (mb-surround "[" (or n 1))))
  (define-key insert-map "]" #'(lambda (n) (interactive "P")
				 (mb-surround "[" (or n 1))))
  (define-key insert-map "{" #'(lambda (n) (interactive "P")
				 (mb-surround "{" (or n 1))))
  (define-key insert-map "}" #'(lambda (n) (interactive "P")
				 (mb-surround "{" (or n 1))))
  (define-key insert-map "<" #'(lambda (n) (interactive "P")
				 (mb-surround "<" (or n 1))))
  (define-key insert-map ">" #'(lambda (n) (interactive "P")
				 (mb-surround "<" (or n 1))))
  (define-key insert-map "/" #'(lambda (n) (interactive "P")
				 (mb-surround "/" (or n 1))))
  (define-key insert-map "\\" #'(lambda (n) (interactive "P")
				  (mb-undo-surround (or n 1))))
  (define-key insert-map "0" #'(lambda (n) (interactive "P")
				 (insert-symbol-deg (or n 1))))
  (define-key insert-map "1" (insert-n "¹"))
  (define-key insert-map "4" (insert-n "AAA"))
  (define-key insert-map "2" #'(lambda (n) (interactive "P")
				 (insert-symbol-sup2 (or n 1))))
  (define-key insert-map "3" #'(lambda (n) (interactive "P")
				 (insert-symbol-sup3 (or n 1))))
  (define-key insert-map "@" #'mb-texinfo-insert-@var))

(let ((big-insert-map (make-sparse-keymap)))
  (key-chord-define evil-normal-state-map "vI" big-insert-map)
  (define-key big-insert-map "\"" #'(lambda (n) (interactive "P")
				      (mb-surround "\\\"" (or n 1)))))

(key-chord-define evil-normal-state-map "kj" mb-evil-eval-map)
(define-key mb-evil-eval-map "k" #'mb-compile-buffer)
(define-key mb-evil-eval-map "d" #'mb-eval-defun)
(define-key mb-evil-eval-map "b" #'mb-eval-buffer)
(define-key mb-evil-eval-map "s" #'mb-eval-region-from-point)
(define-key mb-evil-eval-map "S" #'mb-eval-region-to-point)
(define-key mb-evil-eval-map "r" #'mb-eval-region)
(define-key mb-evil-eval-map "l" #'mb-eval-last-sexp)
(define-key mb-evil-eval-map "f" #'eval-form)
(define-key mb-evil-eval-map "c" #'eval-current-sexp)
(define-key mb-evil-eval-map "e" #'eval-expression)
(define-key mb-evil-eval-map "t" #'eval-defun-test)
(define-key mb-evil-eval-map "T" #'(lambda () (interactive) (eval-defun-test t)))

(key-chord-define evil-normal-state-map "cv" mb-evil-clipboard-map)
(define-key mb-evil-clipboard-map "f" #'buffer-file-name-to-clipboard)
(define-key mb-evil-clipboard-map "b" #'buffer-name-to-clipboard)

(define-key evil-outer-text-objects-map "g" #'mb-evil-buffer)
(define-key evil-inner-text-objects-map "v" #'mb-evil-inner-variable-name)
(define-key evil-inner-text-objects-map "D" #'mb-evil-inner-defun))

(defun mb-evil-map-activate-if-available ()
  "Install personal Evil bindings when Evil is installed.
Return non-nil when activation occurred."
  (when (locate-library "evil")
    (require 'mb-evil)
    (require 'key-chord)
    (mb-evil-map-setup)
    t))

(mb-evil-map-activate-if-available)

(provide 'mb-evil-map)

;;; mb-evil-map.el ends here
