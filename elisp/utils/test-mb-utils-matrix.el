;;; test-mb-utils-matrix.el --- Tests for mb-utils-matrix -*- lexical-binding: t; -*-

(require 'ert)
(require 'mb-utils-matrix)

(ert-deftest mb-utils-matrix-vector-generators ()
  (should (equal (vec '(1 2) '(4 6)) '(3 4)))
  (should (equal (vec-constant) '(0 0 0)))
  (should (equal (vec-constant 2 7) '(7 7)))
  (should (equal (vec-a-b -1 2) '(-1 0 1 2)))
  (should (equal (vec-0-n-1 4) '(0 1 2 3)))
  (should (equal (vec-unit 2 4 5) '(0 0 5 0))))

(ert-deftest mb-utils-matrix-random-vector-seeding ()
  (let (random-seeds random-star-seeds)
    (cl-letf (((symbol-function 'random)
	       (lambda (&optional seed)
		 (push seed random-seeds)
		 0))
	      ((symbol-function 'random*)
	       (lambda (_a _b _integerp &optional seed)
		 (push seed random-star-seeds)
		 1)))
      (should (equal (vec-random 3 0 10 t t) '(1 1 1))))
    (should (equal random-seeds '(t)))
    (should (equal random-star-seeds '(nil nil nil)))))

(ert-deftest mb-utils-matrix-vector-arithmetic ()
  (should (equal (vec-add '(1 2) '(3 4)) '(4 6)))
  (should (equal (vec-subtract '(5 7) '(2 3)) '(3 4)))
  (should (equal (vec-elt-mult '(1 2 3) '(4 5 6)) '(4 10 18)))
  (should (equal (vec-scalar-mult '(1 2 3) 3) '(3 6 9)))
  (should (= (vec-sum nil) 0))
  (should (= (scalar-product '(1 2 3) '(4 5 6)) 32))
  (should-error (vec-add '(1 2) '(3))))

(ert-deftest mb-utils-matrix-vector-geometry ()
  (should (= (vec-sqr '(3 4)) 25))
  (should (= (vec-length '(3 4)) 5.0))
  (should (equal (vec-direction '(3 4)) '(0.6000000000000001 0.8)))
  (should (= (vec-distance '(0 0) '(3 4)) 5.0))
  (should (equal (vec-dyadic-product '(1 2) '(3 4))
		 '((3 4) (6 8))))
  (should (= (vec-curl '(1 0) '(0 1)) 1))
  (should (< (abs (- (vec-angle '(1 0) '(0 1)) (/ float-pi 2)))
	     1e-12))
  (should (< (abs (- (vec-angle '(1 0) '(0 -1)) (* 3 (/ float-pi 2))))
	     1e-12))
  (should-error (vec-direction '(0 0)))
  (should-error (vec-angle '(1 0 0) '(0 1 0))))

(ert-deftest mb-utils-matrix-dimensions-and-transpose ()
  (should (equal (mat-dimension '((1 2 3) (4 5 6))) '(2 3)))
  (should (equal (mat-dimension nil) '(0 0)))
  (should (equal (transpose '((1 2 3) (4 5 6)))
		 '((1 4) (2 5) (3 6))))
  (should-error (mat-columns '((1 2) (3)))))

(ert-deftest mb-utils-matrix-vector-products ()
  (let ((matrix '((1 2 3) (4 5 6))))
    (should (equal (mat-vec-mult matrix '(1 0 1)) '(4 10)))
    (should (equal (vec-mat-mult '(1 2) matrix) '(9 12 15))))
  (should-error (mat-vec-mult '((1 2)) '(1)))
  (should-error (vec-mat-mult '(1) '((1 2) (3 4)))))

(ert-deftest mb-utils-matrix-norms-and-pseudoinverses ()
  (should (< (abs (- (frobenius-norm '((1 2) (3 4))) (sqrt 30)))
	     1e-12))
  (should (equal (vec-pseudo-inverse '(1 2)) '(0.2 0.4)))
  (should (equal (mat-pseudo-inverse '((1 2))) '((0.2) (0.4))))
  (should (equal (mat-pseudo-inverse '((1) (2))) '((0.2 0.4))))
  (should-error (vec-pseudo-inverse '(0 0)))
  (should-error (mat-pseudo-inverse '((1 0) (0 1)))))

(ert-deftest mb-utils-matrix-generators ()
  (should (equal (mat-constant 2 3 7) '((7 7) (7 7) (7 7))))
  (should (equal (mat-diagonal '(2 3)) '((2 0) (0 3))))
  (should (equal (mat-identity 3)
		 '((1 0 0) (0 1 0) (0 0 1)))))

(ert-deftest mb-utils-matrix-matrix-arithmetic ()
  (should (equal (mat-scalar-mult '((1 2) (3 4)) 2)
		 '((2 4) (6 8))))
  (should (equal (mat-add '((1 2) (3 4)) '((4 3) (2 1)))
		 '((5 5) (5 5))))
  (should (equal (mat-subtract '((5 5) (5 5)) '((1 2) (3 4)))
		 '((4 3) (2 1))))
  (should (equal (hadamard-product '((1 2) (3 4)) '((2 3) (4 5)))
		 '((2 6) (12 20))))
  (should-error (mat-add '((1 2)) '((1) (2)))))

(ert-deftest mb-utils-matrix-multiplication ()
  (should (equal (mat-mat-mult '((1 2)) '((3 4) (5 6)))
		 '((13 16))))
  (should (equal (mat-mat-mult*
		  '((1 2)) '((1 0) (0 1)) '((3) (4)))
		 '((11))))
  (should-error (mat-mat-mult '((1 2)) '((1 2)))))

(ert-deftest mb-utils-matrix-permutations ()
  (should (equal (mat-permutation '(0 2 1))
		 '((1 0 0) (0 0 1) (0 1 0))))
  (should (equal (mat-permutation-row-switch 3 0 2)
		 '((0 0 1) (0 1 0) (1 0 0))))
  (should-error (mat-permutation '(0 0 1))))

(provide 'test-mb-utils-matrix)

;;; test-mb-utils-matrix.el ends here
